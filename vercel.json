{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["fra1"],
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["backend/data/**"] }
    },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/app/main.py" },
    { "src": "/cell/(.*)", "dest": "backend/app/main.py" },
    { "src": "/robots.txt", "dest": "backend/app/main.py" },
    { "src": "/sitemap.xml", "dest": "backend/app/main.py" },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=600, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1",
      "headers": {
        "Cache-Control": "public, max-age=600, stale-while-revalidate=86400"
      }
    },
    { "src": "/", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "headers": [
    {
      "source": "/(favicon.ico|apple-touch-icon.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
